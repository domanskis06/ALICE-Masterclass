{
  "name": "alice-masterclass-js",
  "version": "0.0.0",
  "description": "ALICE MasterClass student web application (Angular)",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c web -o",
    "start:demo": "ng serve -c demo -o",
    "config": "ts-node make-prod.mjs",
    "config:demo": "node make-demo.mjs",
    "build": "ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run config && npm run build -- -c production",
    "build:demo": "npm run config:demo && npm run build -- -c demo",
    "ng:serve": "ng serve -c web -o",
    "test": "ng test --watch=false",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:django": "playwright test --config=playwright.django.config.ts",
    "e2e:teacher": "playwright test --config=playwright.teacher.config.ts",
    "e2e:ui": "playwright test --ui",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular-slider/ngx-slider": "21.0.0",
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "21.0.6",
    "@angular/common": "^21.0.8",
    "@angular/compiler": "^21.0.8",
    "@angular/core": "^21.0.8",
    "@angular/flex-layout": "15.0.0-beta.42",
    "@angular/forms": "^21.0.8",
    "@angular/material": "21.0.6",
    "@angular/platform-browser": "^21.0.8",
    "@angular/platform-browser-dynamic": "^21.0.8",
    "@angular/router": "^21.0.8",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "driver.js": "1.4.0",
    "material-icons": "^0.7.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^19.0.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@babel/runtime": "latest",
    "@nwaltham/fmin": "0.0.3-2",
    "@playwright/test": "^1.59.0",
    "@types/d3": "6.7.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.0",
    "@types/three": "^0.160.0",
    "d3": "6.7.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "optimization-js": "1.5.0",
    "three": "^0.160.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@angular/build": "^21.0.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0"
  }
}
